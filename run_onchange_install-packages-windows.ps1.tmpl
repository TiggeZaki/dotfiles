$ErrorActionPreference = 'Stop'

if (-not (Get-Command winget -ErrorAction SilentlyContinue)) {
    throw 'WinGet is required. Install App Installer from the Microsoft Store and run chezmoi apply again.'
}

# Change this list to make chezmoi run the script again.
$packages = @(
    [PSCustomObject]@{ Id = 'eza-community.eza'; Command = 'eza' }
    [PSCustomObject]@{ Id = 'junegunn.fzf'; Command = 'fzf' }
    [PSCustomObject]@{ Id = 'Git.Git'; Command = 'git' }
    [PSCustomObject]@{ Id = 'Starship.Starship'; Command = 'starship' }
)

foreach ($package in $packages) {
    if (Get-Command $package.Command -ErrorAction SilentlyContinue) {
        Write-Host "$($package.Id) is already available."
        continue
    }

    Write-Host "Installing $($package.Id) with WinGet..."
    winget install `
        --id $package.Id `
        --exact `
        --silent `
        --disable-interactivity `
        --accept-package-agreements `
        --accept-source-agreements

    if ($LASTEXITCODE -ne 0) {
        throw "WinGet failed to install $($package.Id) (exit code $LASTEXITCODE)."
    }
}
