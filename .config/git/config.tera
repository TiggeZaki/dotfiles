[init]
	defaultBranch = main
[fetch]
	prune = true
[pull]
	ff = only
[user]
	name = TiggeZaki
	email = 82169475+TiggeZaki@users.noreply.github.com
[push]
	autoSetupRemote = true
[diff]
	algorithm = histogram
	colorMoved = default
[merge]
	conflictStyle = zdiff3
{% if os() == "windows" %}
[core]
	sshCommand = C:\\\\Windows\\\\System32\\\\OpenSSH\\\\ssh.exe
{% elif os() == "linux" %}
{% if "microsoft" in exec(command="uname -r") | lower %}
[credential]
	helper = /mnt/c/Program\\ Files/Git/mingw64/bin/git-credential-manager.exe
{% endif %}
{% endif %}

[include]
	path = config.local
